echo ""
echo "╔══════════════════════════════════════════════╗"
echo "║  pre-push: regression gates (medium)         ║"
echo "╚══════════════════════════════════════════════╝"
echo ""

# npm workspace: a single root install hoists backend + frontend deps.
[ -d node_modules ] || npm ci --no-audit --no-fund >/dev/null 2>&1 || true

# ─────── Backend: typecheck + jest ───────
if [ -d backend ]; then
  echo "▶ backend: tsc --noEmit"
  npm run typecheck --workspace=backend || {
    echo "❌ backend typecheck failed"; exit 1;
  }
  echo "▶ backend: jest"
  npm test --workspace=backend -- --silent --passWithNoTests || {
    echo "❌ backend jest failed — fix before push"; exit 1;
  }
fi

# ─────── Frontend: typecheck ───────
if [ -d frontend ]; then
  echo "▶ frontend: tsc --noEmit"
  npm run typecheck --workspace=frontend || {
    echo "❌ frontend typecheck failed"; exit 1;
  }
fi

# ─────── Repo hygiene: no .env files leaking ───────
if git ls-files | grep -E "^\.env$|\.env\.[a-z]+$" | grep -v "\.env\.example$" | grep -v node_modules >/dev/null 2>&1; then
  echo "❌ Real .env files are being committed. Add them to .gitignore."; exit 1;
fi

echo ""
echo "✅ pre-push gates passed"
