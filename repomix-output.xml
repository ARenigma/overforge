const axios = require('axios');

const JUDGE0_API_URL = process.env.JUDGE0_API_URL || 'http://localhost:2358';

// Submit code to Judge0 and poll for result
exports.executeCode = async ({ source_code, language_id, stdin }) => {
  // Submit code
  const submission = await axios.post(`${JUDGE0_API_URL}/submissions/?base64_encoded=false&wait=false`, {
    source_code,
    language_id,
    stdin
  });
  const token = submission.data.token;

  // Poll for result
  let result;
  for (let i = 0; i < 20; i++) { // Poll up to 20 times
    await new Promise((r) => setTimeout(r, 1000)); // Wait 1s
    const res = await axios.get(`${JUDGE0_API_URL}/submissions/${token}?base64_encoded=false`);
    if (res.data.status && res.data.status.id >= 3) {
      result = res.data;
      break;
    }
  }
  return result;
};
</file>

<file path="backend/src/sockets/index.js">
const { analyzeCode } = require('../services/aiService');

// Simple debounce map for each room
const debounceTimers = {};

module.exports.setupSockets = (io) => {
  io.on('connection', (socket) => {
    console.log('A user connected:', socket.id);

    // Join a Socket.io room
    socket.on('joinRoom', ({ roomName, userId }) => {
      if (roomName) {
        socket.join(roomName);
        socket.roomName = roomName;
        socket.userId = userId;
        console.log(`User ${userId} joined room ${roomName}`);
        // Notify others in the room
        socket.to(roomName).emit('userJoined', { userId });
      }
    });

    // Leave a Socket.io room
    socket.on('leaveRoom', ({ roomName, userId }) => {
      if (roomName) {
        socket.leave(roomName);
        console.log(`User ${userId} left room ${roomName}`);
        socket.to(roomName).emit('userLeft', { userId });
      }
    });

    // WebRTC signaling relay
    socket.on('signal', ({ roomName, from, to, data }) => {
      if (roomName && to) {
        // Relay the signal to the intended recipient in the room
        for (const [id, s] of io.of('/').sockets) {
          if (s.roomName === roomName && s.userId === to) {
            s.emit('signal', { from, data });
          }
        }
      }
    });

    // Real-time code sync + AI analysis
    socket.on('codeChange', ({ roomName, code, language, userId }) => {
      if (roomName) {
        // Broadcast code change to all other users in the room
        socket.to(roomName).emit('codeUpdate', { code });

        // Debounce AI analysis per room
        if (debounceTimers[roomName]) clearTimeout(debounceTimers[roomName]);
        debounceTimers[roomName] = setTimeout(async () => {
          const aiResult = await analyzeCode({ code, language, userId, roomName });
          if (aiResult && aiResult.question) {
            io.to(roomName).emit('aiQuestion', aiResult);
          }
        }, 1500); // 1.5s debounce
      }
    });

    // Real-time chat/messages
    socket.on('chatMessage', ({ roomName, userId, message }) => {
      if (roomName && message) {
        io.to(roomName).emit('chatMessage', {
          userId,
          message,
          timestamp: new Date().toISOString()
        });
      }
    });

    socket.on('disconnect', () => {
      console.log('User disconnected:', socket.id);
    });
  });
};
</file>

