```diff
@@ -9,6 +9,6 @@
  
  # Compile any .java files in the source directory, but only if they exist
- RUN find . -name "*.java" -print0 | xargs -0 -r javac
+ # RUN find . -name "*.java" -print0 | xargs -0 -r javac
  
  # Set the command to run the main class
- CMD ["java", "Main"] 
+ CMD ["tail", "-f", "/dev/null"] 
```

