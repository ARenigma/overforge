+   /**
+    * Check if Docker is available on the system
+    */
+   async checkDockerAvailability() {
+     return new Promise((resolve) => {
+       exec('docker --version', (error) => {
+         if (error) {
+           console.log('⚠️  Docker not found on system - container features will be disabled');
+           resolve(false);
+         } else {
+           resolve(true);
+         }
+       });
+     });
+   }
+ 
