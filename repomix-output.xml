  useEffect(() => {
    let interval: NodeJS.Timeout
    if (isTimerRunning) {
      interval = setInterval(() => {
        setTimer((prev) => prev + 1)
      }, 1000)
    }
    return () => clearInterval(interval)
  }, [isTimerRunning])

  const fetchRoomData = async () => {
    try {
      const token = user.token
      const response = await fetch(`/api/room/${roomId}`, {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      })

      if (response.ok) {
        const data = await response.json()
        setRoomData(data.room)
      } else {
        router.push("/rooms")
      }
    } catch (error) {
      console.error("Failed to fetch room data:", error)
      router.push("/rooms")
    }
  }

  const runCode = async () => {
    setIsRunning(true)
    setOutput("Running code...")

    try {
      const token = user.token
      const response = await fetch(`/api/room/${roomId}/execute`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({
          code,
          language: roomData?.language,
        }),
      })

      const data = await response.json()
      setOutput(data.output || "Code executed successfully!")
    } catch (error) {
      setOutput("Error executing code. Please try again.")
    } finally {
      setIsRunning(false)
    }
  }

  const leaveRoom = () => {
    router.push("/rooms")
  }

  const formatTime = (seconds: number) => {
    const mins = Math.floor(seconds / 60)
    const secs = seconds % 60
    return `${mins.toString().padStart(2, "0")}:${secs.toString().padStart(2, "0")}`
  }

  const getLanguageIcon = (language: string) => {
    const icons: { [key: string]: string } = {
      javascript: "🟨",
      python: "🐍",
      java: "☕",
      cpp: "⚡",
      csharp: "🔷",
      go: "🐹",
      rust: "🦀",
      typescript: "🔷",
    }
    return icons[language] || "💻"
  }

  if (!user) {
    return <AuthForm />
  }

  if (!roomData) {
    return (
      <div className="min-h-screen bg-gray-50 flex items-center justify-center">
        <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-purple-600"></div>
      </div>
    )
  }

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Header */}
      <header className="bg-white border-b">
        <div className="container mx-auto px-4 py-3">
          <div className="flex items-center justify-between">
            <div className="flex items-center space-x-4">
              <div className="flex items-center space-x-2">
                <Code className="h-6 w-6 text-purple-600" />
                <span className="font-bold text-gray-900">{roomData.name}</span>
              </div>
              <Badge variant="secondary">
                {getLanguageIcon(roomData.language)} {roomData.language}
              </Badge>
              <Badge variant="outline">{roomData.experienceLevel} level</Badge>
            </div>

            <div className="flex items-center space-x-4">
              {/* Timer */}
              <div className="flex items-center space-x-2 text-sm">
                <Clock className="h-4 w-4" />
                <span className="font-mono">{formatTime(timer)}</span>
              </div>

              {/* Participants */}
              <div className="flex items-center space-x-2">
                <Users className="h-4 w-4" />
                <div className="flex -space-x-2">
                  {roomData.participants.map((participant) => (
                    <Avatar key={participant.id} className="h-8 w-8 border-2 border-white">
                      <AvatarImage src={participant.avatar || "/placeholder.svg"} />
                      <AvatarFallback>
                        {participant.name
                          .split(" ")
                          .map((n) => n[0])
                          .join("")}
                      </AvatarFallback>
                    </Avatar>
                  ))}
                </div>
              </div>

              <Button variant="outline" onClick={() => setShowAIQuestion(true)}>
                AI Question
              </Button>

              <Button variant="outline" onClick={leaveRoom}>
                <LogOut className="h-4 w-4 mr-2" />
                Leave
              </Button>
            </div>
          </div>
        </div>
      </header>

      {/* Main Content */}
      <div className="container mx-auto px-4 py-4">
        <div className="grid grid-cols-12 gap-4 h-[calc(100vh-120px)]">
          {/* Left Panel - Video and Chat */}
          <div className={`${isVideoExpanded ? "col-span-6" : "col-span-3"} space-y-4`}>
            {/* Video Panel */}
            <Card className="h-64">
              <CardHeader className="pb-2">
                <div className="flex items-center justify-between">
                  <CardTitle className="text-sm flex items-center space-x-2">
                    <Video className="h-4 w-4" />
                    <span>Video Chat</span>
                  </CardTitle>
                  <Button variant="ghost" size="sm" onClick={() => setIsVideoExpanded(!isVideoExpanded)}>
                    {isVideoExpanded ? <Minimize2 className="h-4 w-4" /> : <Maximize2 className="h-4 w-4" />}
                  </Button>
                </div>
              </CardHeader>
              <CardContent className="p-2">
                <VideoPanel participants={roomData.participants} />
              </CardContent>
            </Card>

            {/* Chat Panel */}
            <Card className="flex-1">
              <CardHeader className="pb-2">
                <CardTitle className="text-sm flex items-center space-x-2">
                  <MessageSquare className="h-4 w-4" />
                  <span>Chat</span>
                </CardTitle>
              </CardHeader>
              <CardContent className="p-2 h-full">
                <ChatPanel roomId={roomId} user={user} />
              </CardContent>
            </Card>
          </div>

          {/* Center Panel - Code Editor */}
          <div className={`${isVideoExpanded ? "col-span-4" : "col-span-6"} space-y-4`}>
            <Card className="h-full">
              <CardHeader className="pb-2">
                <div className="flex items-center justify-between">
                  <CardTitle className="text-sm flex items-center space-x-2">
                    <Code className="h-4 w-4" />
                    <span>Code Editor</span>
                  </CardTitle>
                  <div className="flex items-center space-x-2">
                    <Button onClick={runCode} disabled={isRunning} size="sm">
                      <Play className="h-4 w-4 mr-2" />
                      {isRunning ? "Running..." : "Run"}
                    </Button>
                    <Button variant="outline" size="sm">
                      <Settings className="h-4 w-4" />
                    </Button>
                  </div>
                </div>
              </CardHeader>
              <CardContent className="p-0 h-full">
                <CodeEditor value={code} onChange={setCode} language={roomData.language} height="calc(100vh - 200px)" />
              </CardContent>
            </Card>
          </div>

          {/* Right Panel - Output and Info */}
          <div className={`${isVideoExpanded ? "col-span-2" : "col-span-3"} space-y-4`}>
            {/* Output Panel */}
            <Card className="h-64">
              <CardHeader className="pb-2">
                <CardTitle className="text-sm">Output</CardTitle>
              </CardHeader>
              <CardContent>
                <div className="bg-gray-900 text-green-400 p-3 rounded text-sm font-mono h-48 overflow-auto">
                  {output || "Run your code to see output here..."}
                </div>
              </CardContent>
            </Card>

            {/* Room Info */}
            <Card className="flex-1">
              <CardHeader className="pb-2">
                <CardTitle className="text-sm">Room Info</CardTitle>
              </CardHeader>
              <CardContent className="space-y-3">
                <div>
                  <p className="text-xs text-gray-500">Room ID</p>
                  <p className="text-sm font-mono">{roomData.id}</p>
                </div>
                <Separator />
                <div>
                  <p className="text-xs text-gray-500">Participants</p>
                  <div className="space-y-1">
                    {roomData.participants.map((participant) => (
                      <div key={participant.id} className="flex items-center space-x-2">
                        <Avatar className="h-6 w-6">
                          <AvatarImage src={participant.avatar || "/placeholder.svg"} />
                          <AvatarFallback className="text-xs">
                            {participant.name
                              .split(" ")
                              .map((n) => n[0])
                              .join("")}
                          </AvatarFallback>
                        </Avatar>
                        <span className="text-sm">{participant.name}</span>
                        <Badge variant="outline" className="text-xs">
                          {participant.role}
                        </Badge>
                      </div>
                    ))}
                  </div>
                </div>
                <Separator />
                <div>
                  <p className="text-xs text-gray-500">Session Time</p>
                  <p className="text-sm font-mono">{formatTime(timer)}</p>
                </div>
              </CardContent>
            </Card>
          </div>
        </div>
      </div>

      {/* AI Question Modal */}
      <AIQuestionModal
        isOpen={showAIQuestion}
        onClose={() => setShowAIQuestion(false)}
        language={roomData.language}
        experienceLevel={roomData.experienceLevel}
        onTimerPause={() => setIsTimerRunning(false)}
        onTimerResume={() => setIsTimerRunning(true)}
      />
    </div>
  )
}
</file>

<file path="frontend/app/rooms/page.tsx">
"use client"

import { useState, useEffect } from "react"
import { useRouter } from "next/navigation"
import { Button } from "@/components/ui/button"
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card"
import { Input } from "@/components/ui/input"
import { Badge } from "@/components/ui/badge"
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar"
import { Alert, AlertDescription } from "@/components/ui/alert"
import { Code, Plus, Users, Clock, LogOut, RefreshCwIcon as Refresh } from "lucide-react"

interface Room {
  id: string
  name: string
  participants: number
  maxParticipants: number
  language: string
  experienceLevel: string
  createdBy: string
  createdAt: string
  status: "waiting" | "active" | "completed"
}

export default function RoomManager() {
  const [rooms, setRooms] = useState<Room[]>([])
  const [newRoomName, setNewRoomName] = useState("")
  const [joinRoomId, setJoinRoomId] = useState("")
  const [user, setUser] = useState<any>(null)
  const [selectedLanguage, setSelectedLanguage] = useState("")
  const [selectedExperience, setSelectedExperience] = useState("")
  const [isLoading, setIsLoading] = useState(false)
  const [error, setError] = useState("")
  const router = useRouter()

  useEffect(() => {
    const token = localStorage.getItem("token")
    const userData = localStorage.getItem("user")
    const language = localStorage.getItem("selectedLanguage")
    const experience = localStorage.getItem("selectedExperience")

    if (!token || !userData || !language || !experience) {
      router.push("/auth")
      return
    }

    setUser(JSON.parse(userData))
    setSelectedLanguage(language)
    setSelectedExperience(experience)
    fetchRooms()
  }, [router])

  const fetchRooms = async () => {
    try {
      const token = localStorage.getItem("token")
      const response = await fetch("/api/rooms", {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      })

      if (response.ok) {
        const data = await response.json()
        setRooms(data.rooms)
      }
    } catch (error) {
      console.error("Failed to fetch rooms:", error)
    }
  }

  const createRoom = async () => {
    if (!newRoomName.trim()) return

    setIsLoading(true)
    setError("")

    try {
      const token = localStorage.getItem("token")
      const response = await fetch("/api/rooms", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({
          name: newRoomName,
          language: selectedLanguage,
          experienceLevel: selectedExperience,
        }),
      })

      const data = await response.json()

      if (response.ok) {
        router.push(`/room/${data.room.id}`)
      } else {
        setError(data.message || "Failed to create room")
      }
    } catch (error) {
      setError("Network error. Please try again.")
    } finally {
      setIsLoading(false)
    }
  }

  const joinRoom = async (roomId: string) => {
    setIsLoading(true)
    setError("")

    try {
      const token = localStorage.getItem("token")
      const response = await fetch(`/api/rooms/${roomId}/join`, {
        method: "POST",
        headers: {
          Authorization: `Bearer ${token}`,
        },
      })

      const data = await response.json()

      if (response.ok) {
        router.push(`/room/${roomId}`)
      } else {
        setError(data.message || "Failed to join room")
      }
    } catch (error) {
      setError("Network error. Please try again.")
    } finally {
      setIsLoading(false)
    }
  }

  const handleLogout = () => {
    localStorage.removeItem("token")
    localStorage.removeItem("user")
    localStorage.removeItem("selectedLanguage")
    localStorage.removeItem("selectedExperience")
    router.push("/auth")
  }

  const getLanguageIcon = (language: string) => {
    const icons: { [key: string]: string } = {
      javascript: "🟨",
      python: "🐍",
      java: "☕",
      cpp: "⚡",
      csharp: "🔷",
      go: "🐹",
      rust: "🦀",
      typescript: "🔷",
    }
    return icons[language] || "💻"
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-purple-50 to-blue-100">
      {/* Header */}
      <header className="bg-white border-b">
        <div className="container mx-auto px-4 py-4 flex items-center justify-between">
          <div className="flex items-center space-x-2">
            <Code className="h-8 w-8 text-purple-600" />
            <span className="text-xl font-bold text-gray-900">CodeInterview</span>
          </div>

          <div className="flex items-center space-x-4">
            {user && (
              <div className="flex items-center space-x-2">
                <Avatar className="h-8 w-8">
                  <AvatarImage src="/placeholder.svg" />
                  <AvatarFallback>
                    {user.firstName[0]}
                    {user.lastName[0]}
                  </AvatarFallback>
                </Avatar>
                <span className="text-sm font-medium">
                  {user.firstName} {user.lastName}
                </span>
              </div>
            )}
            <Button variant="outline" onClick={handleLogout}>
              <LogOut className="h-4 w-4 mr-2" />
              Logout
            </Button>
          </div>
        </div>
      </header>

      <div className="container mx-auto px-4 py-8">
        <div className="space-y-6">
          {/* User Preferences */}
          <Card>
            <CardHeader>
              <CardTitle>Your Interview Setup</CardTitle>
              <CardDescription>Current language and experience level preferences</CardDescription>
            </CardHeader>
            <CardContent>
              <div className="flex items-center space-x-4">
                <Badge variant="secondary">
                  {getLanguageIcon(selectedLanguage)} {selectedLanguage?.toUpperCase()}
                </Badge>
                <Badge variant="outline">{selectedExperience?.toUpperCase()} Level</Badge>
                <Button
                  variant="ghost"
                  size="sm"
                  onClick={() => router.push("/language-selection")}
                  className="ml-auto"
                >
                  Change Preferences
                </Button>
              </div>
            </CardContent>
          </Card>

          {error && (
            <Alert variant="destructive">
              <AlertDescription>{error}</AlertDescription>
            </Alert>
          )}

          {/* Create Room */}
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center space-x-2">
                <Plus className="h-5 w-5" />
                <span>Create New Room</span>
              </CardTitle>
              <CardDescription>Start a new coding interview session</CardDescription>
            </CardHeader>
            <CardContent>
              <div className="flex space-x-2">
                <Input
                  placeholder="Enter room name"
                  value={newRoomName}
                  onChange={(e) => setNewRoomName(e.target.value)}
                  onKeyPress={(e) => e.key === "Enter" && createRoom()}
                />
                <Button onClick={createRoom} disabled={isLoading || !newRoomName.trim()}>
                  {isLoading ? "Creating..." : "Create Room"}
                </Button>
              </div>
            </CardContent>
          </Card>

          {/* Join Room */}
          <Card>
            <CardHeader>
              <CardTitle>Join Existing Room</CardTitle>
              <CardDescription>Enter a room ID to join an ongoing interview</CardDescription>
            </CardHeader>
            <CardContent>
              <div className="flex space-x-2">
                <Input
                  placeholder="Enter room ID"
                  value={joinRoomId}
                  onChange={(e) => setJoinRoomId(e.target.value)}
                  onKeyPress={(e) => e.key === "Enter" && joinRoom(joinRoomId)}
                />
                <Button onClick={() => joinRoom(joinRoomId)} disabled={isLoading || !joinRoomId.trim()}>
                  {isLoading ? "Joining..." : "Join Room"}
                </Button>
              </div>
            </CardContent>
          </Card>

          {/* Active Rooms */}
          <Card>
            <CardHeader>
              <div className="flex items-center justify-between">
                <div>
                  <CardTitle>Active Rooms</CardTitle>
                  <CardDescription>Available interview rooms you can join</CardDescription>
                </div>
                <Button variant="outline" size="sm" onClick={fetchRooms}>
                  <Refresh className="h-4 w-4 mr-2" />
                  Refresh
                </Button>
              </div>
            </CardHeader>
            <CardContent>
              {rooms.length === 0 ? (
                <div className="text-center py-8 text-gray-500">
                  <Users className="h-12 w-12 mx-auto mb-4 opacity-50" />
                  <p>No active rooms available</p>
                  <p className="text-sm">Create a new room to get started</p>
                </div>
              ) : (
                <div className="space-y-4">
                  {rooms.map((room) => (
                    <div key={room.id} className="border rounded-lg p-4 hover:bg-gray-50 transition-colors">
                      <div className="flex items-center justify-between">
                        <div className="space-y-1">
                          <div className="flex items-center space-x-2">
                            <h3 className="font-semibold">{room.name}</h3>
                            <Badge
                              variant={
                                room.status === "active"
                                  ? "default"
                                  : room.status === "waiting"
                                    ? "secondary"
                                    : "outline"
                              }
                            >
                              {room.status}
                            </Badge>
                          </div>
                          <div className="flex items-center space-x-4 text-sm text-gray-600">
                            <span className="flex items-center space-x-1">
                              <Users className="h-4 w-4" />
                              <span>
                                {room.participants}/{room.maxParticipants}
                              </span>
                            </span>
                            <span>
                              {getLanguageIcon(room.language)} {room.language}
                            </span>
                            <span>{room.experienceLevel} level</span>
                            <span className="flex items-center space-x-1">
                              <Clock className="h-4 w-4" />
                              <span>{new Date(room.createdAt).toLocaleTimeString()}</span>
                            </span>
                          </div>
                          <p className="text-xs text-gray-500">Created by {room.createdBy}</p>
                        </div>
                        <Button
                          onClick={() => joinRoom(room.id)}
                          disabled={room.participants >= room.maxParticipants || room.status === "completed"}
                          size="sm"
                        >
                          Join
                        </Button>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
  )
}
</file>

<file path="frontend/app/signup/page.tsx">
"use client"

import type React from "react"

import { useState } from "react"
import Link from "next/link"
import { useRouter } from "next/navigation"
import { Button } from "@/components/ui/button"
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card"
import { Input } from "@/components/ui/input"
import { Label } from "@/components/ui/label"
import { Alert, AlertDescription } from "@/components/ui/alert"
import { Checkbox } from "@/components/ui/checkbox"
import { BarChart3, Eye, EyeOff } from "lucide-react"

export default function SignupPage() {
  const [formData, setFormData] = useState({
    firstName: "",
    lastName: "",
    email: "",
    password: "",
    confirmPassword: "",
    agreeToTerms: false,
  })
  const [showPassword, setShowPassword] = useState(false)
  const [showConfirmPassword, setShowConfirmPassword] = useState(false)
  const [isLoading, setIsLoading] = useState(false)
  const [error, setError] = useState("")
  const router = useRouter()

  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const { name, value } = e.target
    setFormData((prev) => ({ ...prev, [name]: value }))
  }

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    setIsLoading(true)
    setError("")

    if (formData.password !== formData.confirmPassword) {
      setError("Passwords do not match")
      setIsLoading(false)
      return
    }

    if (!formData.agreeToTerms) {
      setError("Please agree to the terms and conditions")
      setIsLoading(false)
      return
    }

    try {
      const response = await fetch("/api/auth/signup", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          firstName: formData.firstName,
          lastName: formData.lastName,
          email: formData.email,
          password: formData.password,
        }),
      })

      const data = await response.json()

      if (response.ok) {
        router.push("/login?message=Account created successfully")
      } else {
        setError(data.message || "Signup failed")
      }
    } catch (error) {
      setError("Network error. Please try again.")
    } finally {
      setIsLoading(false)
    }
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center p-4">
      <Card className="w-full max-w-md">
        <CardHeader className="text-center">
          <div className="flex items-center justify-center space-x-2 mb-4">
            <BarChart3 className="h-8 w-8 text-blue-600" />
            <span className="text-2xl font-bold text-gray-900">DataFlow</span>
          </div>
          <CardTitle className="text-2xl">Create your account</CardTitle>
          <CardDescription>Get started with your free account today</CardDescription>
        </CardHeader>
        <CardContent>
          <form onSubmit={handleSubmit} className="space-y-4">
            {error && (
              <Alert variant="destructive">
                <AlertDescription>{error}</AlertDescription>
              </Alert>
            )}

            <div className="grid grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label htmlFor="firstName">First Name</Label>
                <Input
                  id="firstName"
                  name="firstName"
                  placeholder="John"
                  value={formData.firstName}
                  onChange={handleInputChange}
                  required
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="lastName">Last Name</Label>
                <Input
                  id="lastName"
                  name="lastName"
                  placeholder="Doe"
                  value={formData.lastName}
                  onChange={handleInputChange}
                  required
                />
              </div>
            </div>

            <div className="space-y-2">
              <Label htmlFor="email">Email</Label>
              <Input
                id="email"
                name="email"
                type="email"
                placeholder="john@example.com"
                value={formData.email}
                onChange={handleInputChange}
                required
              />
            </div>

            <div className="space-y-2">
              <Label htmlFor="password">Password</Label>
              <div className="relative">
                <Input
                  id="password"
                  name="password"
                  type={showPassword ? "text" : "password"}
                  placeholder="Create a strong password"
                  value={formData.password}
                  onChange={handleInputChange}
                  required
                />
                <Button
                  type="button"
                  variant="ghost"
                  size="sm"
                  className="absolute right-0 top-0 h-full px-3 py-2 hover:bg-transparent"
                  onClick={() => setShowPassword(!showPassword)}
                >
                  {showPassword ? <EyeOff className="h-4 w-4" /> : <Eye className="h-4 w-4" />}
                </Button>
              </div>
            </div>

            <div className="space-y-2">
              <Label htmlFor="confirmPassword">Confirm Password</Label>
              <div className="relative">
                <Input
                  id="confirmPassword"
                  name="confirmPassword"
                  type={showConfirmPassword ? "text" : "password"}
                  placeholder="Confirm your password"
                  value={formData.confirmPassword}
                  onChange={handleInputChange}
                  required
                />
                <Button
                  type="button"
                  variant="ghost"
                  size="sm"
