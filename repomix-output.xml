const createSessionLimiter = rateLimit({
  windowMs: 15 * 60 * 1000, // 15 minutes
  max: 10, // Limit each user to 10 sessions per windowMs
  message: {
    success: false,
    error: 'Too many sessions created. Please try again later.'
  },
  standardHeaders: true,
  legacyHeaders: false,
});

// Validation middleware for session creation
const validateSessionCreation = [
  body('title')
    .notEmpty()
    .withMessage('Session title is required')
    .isLength({ max: 200 })
    .withMessage('Title must be less than 200 characters'),
  
  body('jobDescription')
    .notEmpty()
    .withMessage('Job description is required')
    .isLength({ min: 50, max: 5000 })
    .withMessage('Job description must be between 50 and 5000 characters'),
  
  body('language')
    .isIn(['javascript', 'python', 'java', 'cpp', 'csharp', 'go', 'rust'])
    .withMessage('Invalid programming language'),
  
  body('experienceLevel')
    .isIn(['junior', 'mid', 'senior'])
    .withMessage('Invalid experience level'),
  
  body('maxDuration')
    .optional()
    .isInt({ min: 15, max: 180 })
    .withMessage('Duration must be between 15 and 180 minutes'),
];

// Create new interview session
router.post('/create', 
  authenticateSupabase,
  createSessionLimiter,
  validateSessionCreation,
  async (req, res) => {
  try {
    // Check validation errors
    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({
        success: false,
        error: 'Validation failed',
        details: errors.array()
      });
    }

    const {
      title,
      jobDescription,
      language,
      experienceLevel,
      maxDuration = 60,
      isPublic = false,
      allowedCandidateEmails = [],
      notes,
      tags = []
    } = req.body;

    // Create session using Supabase service
    const session = await SupabaseSessionService.create({
      title,
      jobDescription,
      language,
      experienceLevel,
      maxDuration,
      isPublic,
      allowedCandidateEmails,
      notes,
      tags,
      interviewerId: req.user.id,
      status: 'created'
    });

    res.status(201).json({
      success: true,
      message: 'Interview session created successfully',
      data: session
    });

  } catch (error) {
    console.error('Session creation error:', error);
    res.status(500).json({
      success: false,
      error: error.message || 'Failed to create session'
    });
  }
});

