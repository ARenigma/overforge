<file path="frontend/components/InterviewerDashboard.tsx">
"use client"

import React, { useState, useEffect } from 'react'
import { Button } from "@/components/ui/button"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import { Badge } from "@/components/ui/badge"
import { Progress } from "@/components/ui/progress"
import { Alert, AlertDescription } from "@/components/ui/alert"
import { AlertTriangle, CheckCircle, Clock, Target, SkipForward, Download } from "lucide-react"
import { JDUploadModal } from "./jd-upload-modal"

interface Parameter {
  name: string
  description: string
  depth_levels: string[]
  current_depth: number
  score: number
  max_score: number
  status: 'pending' | 'in_progress' | 'completed' | 'skipped'
}

interface AssessmentState {
  sessionId: string
  phase: string
  totalScore: number
  maxScore: number
  parameters: Parameter[]
  currentParameterIndex: number
  mainProblem: string
  candidateCode: string
  language: string
  startTime: number
  lastActivity: number
}

interface InterviewerDashboardProps {
  roomId: string
  socket: any
  assessmentState?: AssessmentState
  candidateInfo: {
    name: string
    language: string
    experienceLevel: string
  }
}

export function InterviewerDashboard({ 
  roomId, 
  socket, 
  assessmentState: initialAssessmentState,
  candidateInfo 
}: InterviewerDashboardProps) {
  const [assessmentState, setAssessmentState] = useState<AssessmentState | null>(initialAssessmentState || null)
  const [candidateCode, setCandidateCode] = useState('')
  const [elapsedTime, setElapsedTime] = useState(0)
  const [currentPhase, setCurrentPhase] = useState('foundation')
  const [assessmentHistory, setAssessmentHistory] = useState<any[]>([])

  
  // Update local state when props change
  useEffect(() => {
    if (initialAssessmentState) {
      setAssessmentState(initialAssessmentState)
    }
  }, [initialAssessmentState])

  // Set up socket listeners
  useEffect(() => {
    if (!socket) return

    socket.on('assessmentInitialized', (data: any) => {
      setAssessmentState(data.assessmentState)
      setCurrentPhase(data.assessmentState.phase)
    })

    socket.on('assessmentFeedback', (data: any) => {
      setAssessmentHistory(prev => [...prev, {
        timestamp: Date.now(),
        action: 'feedback',
        message: data.message,
        details: data.details
      }])
    })

    socket.on('codeChange', (data: any) => {
      setCandidateCode(data.code)
      setAssessmentHistory(prev => [...prev, {
        timestamp: Date.now(),
        action: 'code_change',
        message: 'Code updated',
        details: `${data.code.length} characters`
      }])
    })

    socket.on('assessmentComplete', (data: any) => {
      setAssessmentHistory(prev => [...prev, {
        timestamp: Date.now(),
        action: 'complete',
        message: 'Assessment completed',
        details: `Final Score: ${data.finalScore}/${data.maxScore}`
      }])
      setCurrentPhase('complete')
    })

    socket.on('parameterSkipConfirmed', (data: any) => {
      setAssessmentHistory(prev => [...prev, {
        timestamp: Date.now(),
        action: 'parameter_skipped',
        message: `Parameter "${data.skippedParameter}" skipped`,
        details: data.message
      }])
      
      // Update current phase if provided
      if (data.newPhase) {
        setCurrentPhase(data.newPhase)
      }
    })

    socket.on('interviewEndConfirmed', (data: any) => {
      setAssessmentHistory(prev => [...prev, {
        timestamp: Date.now(),
        action: 'interview_ended',
        message: 'Interview ended by interviewer',
        details: `Final Score: ${data.finalScore}/${data.maxScore}, Duration: ${data.completionTime} minutes`
      }])
      
      setCurrentPhase('complete')
    })

    // Error handlers
    socket.on('skipError', (data: any) => {
      setAssessmentHistory(prev => [...prev, {
        timestamp: Date.now(),
        action: 'error',
        message: `Skip Error: ${data.message}`,
        details: 'Failed to skip parameter'
      }])
    })

    socket.on('endInterviewError', (data: any) => {
      setAssessmentHistory(prev => [...prev, {
        timestamp: Date.now(),
        action: 'error',
        message: `End Interview Error: ${data.message}`,
        details: 'Failed to end interview'
      }])
    })

    return () => {
      socket.off('assessmentInitialized')
      socket.off('assessmentFeedback')
      socket.off('codeChange')
      socket.off('assessmentComplete')
      socket.off('parameterSkipConfirmed')
      socket.off('interviewEndConfirmed')
      socket.off('skipError')
      socket.off('endInterviewError')
    }
  }, [socket])

  const formatTime = (ms: number) => {
    const minutes = Math.floor(ms / 60000)
    const seconds = Math.floor((ms % 60000) / 1000)
    return `${minutes}:${seconds.toString().padStart(2, '0')}`
  }

  const getPhaseColor = (phase: string) => {
    switch (phase) {
      case 'foundation': return 'bg-blue-500'
      case 'parameter_1': return 'bg-green-500'
      case 'parameter_2': return 'bg-yellow-500'
      case 'parameter_3': return 'bg-purple-500'
      case 'complete': return 'bg-gray-500'
      default: return 'bg-gray-400'
    }
  }

  const getParameterStatusIcon = (status: string) => {
    switch (status) {
      case 'completed': return <CheckCircle className="w-4 h-4 text-green-500" />
      case 'in_progress': return <Clock className="w-4 h-4 text-blue-500" />
      case 'skipped': return <SkipForward className="w-4 h-4 text-gray-500" />
      default: return <Target className="w-4 h-4 text-gray-400" />
    }
  }

  const handleSkipParameter = () => {
    socket.emit('skipCurrentParameter', { roomId })
  }

  const handleEndInterview = () => {
    socket.emit('endInterview', { roomId })
  }

  const handleExportResults = () => {
    if (!assessmentState) return
    
    const results = {
      sessionId: assessmentState.sessionId,
      candidate: candidateInfo,
      assessment: {
        totalScore: assessmentState.totalScore,
        maxScore: assessmentState.maxScore,
        parameters: assessmentState.parameters,
        phase: assessmentState.phase,
        duration: elapsedTime,
        mainProblem: assessmentState.mainProblem,
        finalCode: candidateCode
      },
      history: assessmentHistory,
      timestamp: new Date().toISOString()
    }
    
    const blob = new Blob([JSON.stringify(results, null, 2)], { type: 'application/json' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = `interview-results-${assessmentState.sessionId}.json`
    a.click()
    URL.revokeObjectURL(url)
  }

  // Handle JD upload success
  const handleJDUploadSuccess = (result: any) => {
    setAssessmentHistory(prev => [...prev, {
      timestamp: Date.now(),
      action: 'jd_uploaded',
      message: `New job profile created: ${result.jobProfile.title}`,
      details: `AI Confidence: ${result.metrics.aiConfidence}%, Parameters: ${result.metrics.parametersGenerated}`
    }])
  }

  // Handle JD upload error
  const handleJDUploadError = (error: string) => {
    setAssessmentHistory(prev => [...prev, {
      timestamp: Date.now(),
      action: 'error',
      message: `JD Upload Failed: ${error}`,
      details: 'Failed to process job description'
    }])
  }

  if (!assessmentState) {
    return (
      <div className="p-6">
        <Alert>
          <AlertTriangle className="h-4 w-4" />
          <AlertDescription>
            No active assessment session. Waiting for candidate to join...
          </AlertDescription>
        </Alert>
      </div>
    )
  }

  const currentParameter = assessmentState.parameters[assessmentState.currentParameterIndex]
  const overallProgress = (assessmentState.totalScore / assessmentState.maxScore) * 100

  return (
    <div className="p-6 space-y-6 max-w-6xl mx-auto">
      {/* Header */}
      <div className="flex justify-between items-center">
        <div>
          <h1 className="text-2xl font-bold text-gray-900">Interviewer Dashboard</h1>
          <p className="text-gray-600">Real-time assessment monitoring and control</p>
            </div>
        <div className="flex gap-2">
            <JDUploadModal
              onSuccess={handleJDUploadSuccess}
              onError={handleJDUploadError}
              trigger={
                <Button variant="outline">
                  Upload New JD
                </Button>
              }
            />
            <Button
            onClick={handleExportResults}
            variant="outline"
          >
            <Download className="w-4 h-4 mr-2" />
            Export Results
            </Button>
          </div>
        </div>

        {/* Candidate Info */}
          <Card>
        <CardHeader>
          <CardTitle>Candidate Information</CardTitle>
            </CardHeader>
            <CardContent>
          <div className="grid grid-cols-3 gap-4">
            <div>
              <p className="text-sm text-gray-600">Name</p>
              <p className="font-medium">{candidateInfo.name}</p>
            </div>
            <div>
              <p className="text-sm text-gray-600">Language</p>
              <p className="font-medium">{candidateInfo.language}</p>
                </div>
            <div>
              <p className="text-sm text-gray-600">Experience</p>
              <p className="font-medium">{candidateInfo.experienceLevel}</p>
                </div>
              </div>
            </CardContent>
          </Card>

      {/* Assessment Overview */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <Card>
          <CardContent className="p-4">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm text-gray-600">Overall Score</p>
                <p className="text-2xl font-bold">{assessmentState.totalScore}/{assessmentState.maxScore}</p>
              </div>
              <div className="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center">
                <Target className="w-6 h-6 text-blue-600" />
              </div>
            </div>
            <Progress value={overallProgress} className="mt-2" />
          </CardContent>
        </Card>

        <Card>
          <CardContent className="p-4">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm text-gray-600">Current Phase</p>
                <p className="text-lg font-medium capitalize">{currentPhase.replace('_', ' ')}</p>
              </div>
              <div className={`w-12 h-12 rounded-full ${getPhaseColor(currentPhase)} flex items-center justify-center`}>
                <CheckCircle className="w-6 h-6 text-white" />
              </div>
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardContent className="p-4">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm text-gray-600">Parameters</p>
                <p className="text-2xl font-bold">{assessmentState.parameters.length}</p>
              </div>
              <div className="w-12 h-12 rounded-full bg-purple-100 flex items-center justify-center">
                <Target className="w-6 h-6 text-purple-600" />
              </div>
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardContent className="p-4">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-sm text-gray-600">Duration</p>
                <p className="text-2xl font-bold">{formatTime(elapsedTime)}</p>
              </div>
              <div className="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center">
                <Clock className="w-6 h-6 text-green-600" />
              </div>
            </div>
          </CardContent>
        </Card>
      </div>

      {/* Parameters */}
          <Card>
        <CardHeader>
          <CardTitle>Assessment Parameters</CardTitle>
            </CardHeader>
        <CardContent>
          <div className="space-y-4">
              {assessmentState.parameters.map((param, index) => (
              <div key={index} className="border rounded-lg p-4">
                <div className="flex items-center justify-between mb-2">
                    <div className="flex items-center gap-2">
                      {getParameterStatusIcon(param.status)}
                    <h3 className="font-medium">{param.name}</h3>
                    <Badge variant={param.status === 'completed' ? 'default' : 'secondary'}>
                      {param.status}
                    </Badge>
                  </div>
                  <div className="text-sm text-gray-600">
                    Depth: {param.current_depth + 1}/3
                  </div>
                </div>
                <p className="text-sm text-gray-600 mb-2">{param.description}</p>
                <div className="flex items-center justify-between">
                  <div>
                    <span className="text-sm text-gray-600">Score: </span>
                    <span className="font-medium">{param.score}/{param.max_score}</span>
                  </div>
                </div>
                </div>
              ))}
          </div>
          
          <div className="mt-6 flex gap-2">
              <Button 
                onClick={handleSkipParameter}
                variant="outline"
              disabled={currentPhase === 'complete'}
              >
                <SkipForward className="w-4 h-4 mr-2" />
                Skip Current Parameter
              </Button>
            <Button 
              onClick={handleEndInterview}
              variant="destructive"
              disabled={currentPhase === 'complete'}
            >
              End Interview
            </Button>
        </div>
                </CardContent>
              </Card>

      {/* Assessment History */}
      <Card>
        <CardHeader>
          <CardTitle>Assessment History</CardTitle>
                </CardHeader>
        <CardContent>
          <div className="space-y-2 max-h-60 overflow-y-auto">
            {assessmentHistory.length === 0 ? (
              <p className="text-gray-500 text-sm">No assessment history yet</p>
            ) : (
              assessmentHistory.slice(-10).reverse().map((entry, index) => (
                <div key={index} className="flex items-center justify-between py-2 border-b border-gray-100 last:border-b-0">
                      <div>
                    <p className="text-sm font-medium">{entry.message}</p>
                    <p className="text-xs text-gray-500">{entry.details}</p>
                  </div>
                  <span className="text-xs text-gray-400">
                    {new Date(entry.timestamp).toLocaleTimeString()}
                            </span>
                          </div>
              ))
                      )}
                    </div>
                </CardContent>
              </Card>


    </div>
  )
}
</file>

<file path="frontend/components/jd-upload-modal.tsx">
"use client"

import React, { useState, useCallback, useRef } from 'react'
import { Upload, File, CheckCircle, XCircle, AlertCircle, Clock, FileText, Trash2 } from 'lucide-react'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card'
import { Progress } from '@/components/ui/progress'
import { Badge } from '@/components/ui/badge'
import { Alert, AlertDescription } from '@/components/ui/alert'
import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle, DialogTrigger } from '@/components/ui/dialog'
import { ScrollArea } from '@/components/ui/scroll-area'
import { useSupabaseAuth } from '@/context/SupabaseAuthContext'

interface ProcessingStep {
  step_name: string
  step_status: 'started' | 'completed' | 'failed' | 'skipped'
  step_message: string
  started_at: string
  completed_at?: string
  duration_ms?: number
}

interface ProcessingResult {
  jobProfileId: string
  jobProfile: any
  metrics: {
    textLength: number
    wordCount: number
    aiConfidence: number
    parametersGenerated: number
    processingTime: number
  }
}

interface JDUploadModalProps {
  onSuccess?: (result: ProcessingResult) => void
  onError?: (error: string) => void
  trigger?: React.ReactNode
}

export function JDUploadModal({ onSuccess, onError, trigger }: JDUploadModalProps) {
  const { user, token } = useSupabaseAuth()
  const [isOpen, setIsOpen] = useState(false)
  const [isDragging, setIsDragging] = useState(false)
  const [selectedFile, setSelectedFile] = useState<File | null>(null)
  const [uploading, setUploading] = useState(false)
  const [processing, setProcessing] = useState(false)
  const [uploadProgress, setUploadProgress] = useState(0)
  const [processingSteps, setProcessingSteps] = useState<ProcessingStep[]>([])
  const [result, setResult] = useState<ProcessingResult | null>(null)
  const [error, setError] = useState<string>('')
  const fileInputRef = useRef<HTMLInputElement>(null)
  const pollInterval = useRef<NodeJS.Timeout | null>(null)

  const supportedTypes = {
    'application/pdf': '.pdf',
    'text/plain': '.txt',
    'application/vnd.openxmlformats-officedocument.wordprocessingml.document': '.docx'
  }

  const maxSizeMB = 1

  const resetState = () => {
    setSelectedFile(null)
    setUploading(false)
    setProcessing(false)
    setUploadProgress(0)
    setProcessingSteps([])
    setResult(null)
    setError('')
    if (pollInterval.current) {
      clearInterval(pollInterval.current)
      pollInterval.current = null
    }
  }

  const validateFile = (file: File): string | null => {
    if (!Object.keys(supportedTypes).includes(file.type)) {
      return `Unsupported file type. Please upload PDF, TXT, or DOCX files.`
    }

    if (file.size > maxSizeMB * 1024 * 1024) {
      return `File size (${(file.size / (1024 * 1024)).toFixed(2)}MB) exceeds the ${maxSizeMB}MB limit.`
    }

    return null
  }

  const handleDragOver = useCallback((e: React.DragEvent) => {
    e.preventDefault()
    setIsDragging(true)
  }, [])

  const handleDragLeave = useCallback((e: React.DragEvent) => {
    e.preventDefault()
    setIsDragging(false)
  }, [])

  const handleDrop = useCallback((e: React.DragEvent) => {
    e.preventDefault()
    setIsDragging(false)
    
    const files = Array.from(e.dataTransfer.files)
    if (files.length > 0) {
      handleFileSelect(files[0])
    }
  }, [])

  const handleFileSelect = (file: File) => {
    const validationError = validateFile(file)
    if (validationError) {
      setError(validationError)
      return
    }

    setSelectedFile(file)
    setError('')
  }

  const handleFileInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = e.target.files
    if (files && files.length > 0) {
      handleFileSelect(files[0])
    }
  }

  const pollProcessingStatus = async (jobProfileId: string) => {
    try {
      const response = await fetch(`/api/jd-upload/status/${jobProfileId}`, {
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        }
      })

      if (response.ok) {
        const data = await response.json()
        if (data.success) {
          setProcessingSteps(data.data.processingLogs)
          
          if (data.data.isComplete) {
            setProcessing(false)
            setUploadProgress(100)
            
            // Get full job profile details
            const profileResponse = await fetch(`/api/jd-upload/profile/${jobProfileId}`, {
              headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
              }
            })
            
            if (profileResponse.ok) {
              const profileData = await profileResponse.json()
              const result: ProcessingResult = {
                jobProfileId,
                jobProfile: profileData.data,
                metrics: {
                  textLength: profileData.data.description?.length || 0,
                  wordCount: profileData.data.description?.split(/\s+/).length || 0,
                  aiConfidence: (profileData.data.ai_confidence_score || 0) * 100,
                  parametersGenerated: profileData.data.parameters?.length || 0,
                  processingTime: profileData.data.processing_completed_at ? 
                    new Date(profileData.data.processing_completed_at).getTime() - 
                    new Date(profileData.data.processing_started_at).getTime() : 0
                }
              }
              setResult(result)
              onSuccess?.(result)
            }
            
            if (pollInterval.current) {
              clearInterval(pollInterval.current)
              pollInterval.current = null
            }
          } else if (data.data.isFailed) {
            setProcessing(false)
            setError(data.data.jobProfile.processing_error || 'Processing failed')
            onError?.(data.data.jobProfile.processing_error || 'Processing failed')
            
            if (pollInterval.current) {
              clearInterval(pollInterval.current)
              pollInterval.current = null
            }
          }
        }
      }
    } catch (error) {
      console.error('Error polling processing status:', error)
    }
  }

  const handleUpload = async () => {
    if (!selectedFile || !token) return

    setUploading(true)
    setError('')

    try {
      const formData = new FormData()
      formData.append('jdFile', selectedFile)

      const response = await fetch('/api/jd-upload', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`
        },
        body: formData
      })

      const data = await response.json()

      if (response.ok && data.success) {
        setUploading(false)
        setProcessing(true)
        setUploadProgress(25)

        // Start polling for processing status
        pollInterval.current = setInterval(() => {
          pollProcessingStatus(data.data.jobProfileId)
        }, 2000) // Poll every 2 seconds

        // Initial status check
        setTimeout(() => pollProcessingStatus(data.data.jobProfileId), 500)

      } else {
        throw new Error(data.error || 'Upload failed')
      }

    } catch (error) {
      setUploading(false)
      const errorMessage = error instanceof Error ? error.message : 'Upload failed'
      setError(errorMessage)
      onError?.(errorMessage)
    }
  }

  const getStepIcon = (status: string) => {
    switch (status) {
      case 'completed':
        return <CheckCircle className="h-4 w-4 text-green-500" />
      case 'failed':
        return <XCircle className="h-4 w-4 text-red-500" />
      case 'started':
        return <Clock className="h-4 w-4 text-blue-500" />
      default:
        return <AlertCircle className="h-4 w-4 text-gray-400" />
    }
  }

  const getStepName = (stepName: string) => {
    const nameMap: Record<string, string> = {
      'file_upload': 'File Upload',
      'text_extraction': 'Text Extraction',
      'ai_analysis': 'AI Analysis',
      'parameter_generation': 'Parameter Generation'
    }
    return nameMap[stepName] || stepName
  }

  const getCurrentProgress = () => {
    if (result) return 100
    if (error) return 0
    
    const stepProgress: Record<string, number> = {
      'file_upload': 25,
      'text_extraction': 50,
      'ai_analysis': 75,
      'parameter_generation': 90
    }
    
    const completedSteps = processingSteps.filter(step => step.step_status === 'completed')
    if (completedSteps.length === 0) return uploadProgress
    
    const lastCompleted = completedSteps[completedSteps.length - 1]
    return stepProgress[lastCompleted.step_name] || uploadProgress
  }

  return (
    <Dialog open={isOpen} onOpenChange={setIsOpen}>
      <DialogTrigger asChild>
        {trigger || (
          <Button variant="outline" className="gap-2">
            <Upload className="h-4 w-4" />
            Upload Job Description
          </Button>
        )}
      </DialogTrigger>
      <DialogContent className="max-w-2xl max-h-[80vh]">
        <DialogHeader>
          <DialogTitle>Upload Job Description</DialogTitle>
          <DialogDescription>
            Upload a PDF, TXT, or DOCX file containing a job description. Our AI will automatically extract key information and create a 3-parameter assessment system.
          </DialogDescription>
        </DialogHeader>

        <div className="space-y-6">
          {!selectedFile && !uploading && !processing && !result && (
            <Card
              className={`border-2 border-dashed transition-colors ${
                isDragging 
                  ? 'border-blue-500 bg-blue-50' 
                  : 'border-gray-300 hover:border-gray-400'
              }`}
              onDragOver={handleDragOver}
              onDragLeave={handleDragLeave}
              onDrop={handleDrop}
            >
              <CardContent className="p-8 text-center">
                <Upload className="h-12 w-12 mx-auto text-gray-400 mb-4" />
                <div className="space-y-2">
                  <p className="text-lg font-medium">
                    Drag and drop your job description here
                  </p>
                  <p className="text-sm text-gray-500">
                    Or click to browse files
                  </p>
                  <div className="flex justify-center gap-2 text-xs text-gray-400">
                    <span>PDF</span> • <span>TXT</span> • <span>DOCX</span>
                    <span>• Max {maxSizeMB}MB</span>
                  </div>
                </div>
                <Button 
                  variant="outline" 
                  className="mt-4"
                  onClick={() => fileInputRef.current?.click()}
                >
                  <File className="h-4 w-4 mr-2" />
                  Browse Files
                </Button>
                <input
                  ref={fileInputRef}
                  type="file"
                  accept={Object.values(supportedTypes).join(',')}
                  onChange={handleFileInputChange}
                  className="hidden"
                />
              </CardContent>
            </Card>
          )}

          {selectedFile && !uploading && !processing && !result && (
            <Card>
              <CardContent className="p-4">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <FileText className="h-8 w-8 text-blue-500" />
                    <div>
                      <p className="font-medium">{selectedFile.name}</p>
                      <p className="text-sm text-gray-500">
                        {(selectedFile.size / (1024 * 1024)).toFixed(2)} MB
                      </p>
                    </div>
                  </div>
                  <div className="flex gap-2">
                    <Button 
                      variant="outline" 
                      size="sm"
                      onClick={() => setSelectedFile(null)}
                    >
                      <Trash2 className="h-4 w-4" />
                    </Button>
                    <Button onClick={handleUpload}>
                      <Upload className="h-4 w-4 mr-2" />
                      Process JD
                    </Button>
                  </div>
                </div>
              </CardContent>
            </Card>
          )}

          {(uploading || processing) && (
            <Card>
              <CardContent className="p-6">
                <div className="space-y-4">
                  <div className="flex items-center justify-between">
                    <h3 className="font-medium">
                      {uploading ? 'Uploading...' : 'Processing Job Description'}
                    </h3>
                    <span className="text-sm text-gray-500">
                      {getCurrentProgress()}%
                    </span>
                  </div>
                  
                  <Progress value={getCurrentProgress()} className="w-full" />
                  
                  {processingSteps.length > 0 && (
                    <div className="space-y-2">
                      <h4 className="text-sm font-medium">Processing Steps:</h4>
                      <div className="space-y-1">
                        {processingSteps.map((step, index) => (
                          <div key={index} className="flex items-center gap-2 text-sm">
                            {getStepIcon(step.step_status)}
                            <span className="flex-1">{getStepName(step.step_name)}</span>
                            {step.step_status === 'completed' && step.duration_ms && (
                              <span className="text-xs text-gray-500">
                                {step.duration_ms}ms
                              </span>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </CardContent>
            </Card>
          )}

          {result && (
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <CheckCircle className="h-5 w-5 text-green-500" />
                  Processing Complete!
                </CardTitle>
                <CardDescription>
                  Your job description has been successfully processed and is ready for use.
                </CardDescription>
              </CardHeader>
              <CardContent className="space-y-4">
                <div className="grid grid-cols-2 gap-4 text-sm">
                  <div>
                    <span className="font-medium">Job Title:</span>
                    <p className="text-gray-600">{result.jobProfile.title}</p>
                  </div>
                  <div>
                    <span className="font-medium">Experience Level:</span>
                    <p className="text-gray-600">{result.jobProfile.experience_level}</p>
                  </div>
                  <div>
                    <span className="font-medium">AI Confidence:</span>
                    <p className="text-gray-600">{result.metrics.aiConfidence.toFixed(1)}%</p>
                  </div>
                  <div>
                    <span className="font-medium">Parameters Generated:</span>
                    <p className="text-gray-600">{result.metrics.parametersGenerated}</p>
                  </div>
                </div>

                <div>
                  <span className="font-medium text-sm">Tech Stack:</span>
                  <div className="flex flex-wrap gap-1 mt-1">
                    {result.jobProfile.extracted_tech_stack?.slice(0, 6).map((tech: string, index: number) => (
                      <Badge key={index} variant="secondary" className="text-xs">
                        {tech}
                      </Badge>
                    ))}
                  </div>
                </div>

                <div className="flex gap-2 pt-2">
                  <Button onClick={() => setIsOpen(false)} className="flex-1">
                    Use This Job Profile
                  </Button>
                  <Button 
                    variant="outline" 
                    onClick={resetState}
                  >
                    Upload Another
                  </Button>
                </div>
              </CardContent>
            </Card>
          )}

          {error && (
            <Alert variant="destructive">
              <XCircle className="h-4 w-4" />
              <AlertDescription>{error}</AlertDescription>
            </Alert>
          )}
        </div>
      </DialogContent>
    </Dialog>
  )
}

export default JDUploadModal
</file>

