<file path="setup/create-problem-solutions-table.sql">
-- Problem Solutions table for comparative depth questioning
-- Safe to run multiple times: create-if-not-exists patterns

-- Enable UUID generation if available
create extension if not exists pgcrypto;

create table if not exists public.problem_solutions (
  id uuid primary key default gen_random_uuid(),
  problem_id uuid not null,
  approach_key text not null,
  title text not null,
  summary text,
  steps jsonb,
  pros jsonb,
  cons jsonb,
  time_complexity text,
  space_complexity text,
  tags text[],
  confidence int,
  version int not null default 1,
  is_active boolean not null default true,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint uq_problem_approach unique (problem_id, approach_key)
);

create index if not exists idx_problem_solutions_problem_id on public.problem_solutions (problem_id);

-- Basic RLS: allow reads to authenticated users, writes only to admins
alter table public.problem_solutions enable row level security;

do $$ begin
  if not exists (
    select 1 from pg_policies 
    where schemaname = 'public' and tablename = 'problem_solutions' and policyname = 'Allow read for authenticated'
  ) then
    create policy "Allow read for authenticated" on public.problem_solutions
      for select
      to authenticated
      using ( true );
  end if;
end $$;

-- Admin-only write policies; assumes a Users table with role column = 'admin'
do $$ begin
  if not exists (
    select 1 from pg_policies 
    where schemaname = 'public' and tablename = 'problem_solutions' and policyname = 'Allow admin insert'
  ) then
    create policy "Allow admin insert" on public.problem_solutions
      for insert
      to authenticated
      with check (
        exists (
          select 1 from public."Users" u 
          where u.id = auth.uid() and u.role = 'admin'
        )
      );
  end if;
end $$;

do $$ begin
  if not exists (
    select 1 from pg_policies 
    where schemaname = 'public' and tablename = 'problem_solutions' and policyname = 'Allow admin update'
  ) then
    create policy "Allow admin update" on public.problem_solutions
      for update
      to authenticated
      using (
        exists (
          select 1 from public."Users" u 
          where u.id = auth.uid() and u.role = 'admin'
        )
      )
      with check (
        exists (
          select 1 from public."Users" u 
          where u.id = auth.uid() and u.role = 'admin'
        )
      );
  end if;
end $$;

do $$ begin
  if not exists (
    select 1 from pg_policies 
    where schemaname = 'public' and tablename = 'problem_solutions' and policyname = 'Allow admin delete'
  ) then
    create policy "Allow admin delete" on public.problem_solutions
      for delete
      to authenticated
      using (
        exists (
          select 1 from public."Users" u 
          where u.id = auth.uid() and u.role = 'admin'
        )
      );
  end if;
end $$;

-- Update trigger to keep updated_at fresh
create or replace function public.set_updated_at()
returns trigger as $$
begin
  new.updated_at = now();
  return new;
end;
$$ language plpgsql;

drop trigger if exists trg_problem_solutions_updated_at on public.problem_solutions;
create trigger trg_problem_solutions_updated_at
before update on public.problem_solutions
for each row execute function public.set_updated_at();
</file>

<file path="start-all.sh">
#!/bin/bash

# Function to kill all background jobs on exit
cleanup() {
    echo "Stopping all services..."
    # Using pkill to be more robust in case jobs -p fails
    pkill -P $$
    exit
}

trap cleanup INT

# --- AI Module Setup ---
AI_MODULE_DIR="ai_module"
VENV_DIR="$AI_MODULE_DIR/venv"

# Check if python3 is available
if ! command -v python3 &> /dev/null
then
    echo "Error: python3 is not installed. Please install Python 3 to run the AI Module."
    exit 1
fi

# Check if virtual environment exists, if not create it and install dependencies
if [ ! -d "$VENV_DIR" ]; then
    echo "Python virtual environment not found. Creating one..."
    python3 -m venv "$VENV_DIR"
    echo "Virtual environment created. Installing dependencies..."
    "$VENV_DIR/bin/pip" install -r "$AI_MODULE_DIR/requirements.txt"
    if [ $? -ne 0 ]; then
        echo "Error: Failed to install dependencies for AI module. Please check requirements.txt and run pip install manually."
        exit 1
    fi
    echo "AI Module dependencies installed."
fi

# --- Start Services ---

# Start Backend
echo "Starting Backend service..."
(cd backend && npm run dev) &
BACKEND_PID=$!

# Start AI Module
echo "Starting AI Module service..."
(cd $AI_MODULE_DIR && ../$VENV_DIR/bin/uvicorn app:app --reload --port 8000) &
AI_MODULE_PID=$!

# Start Frontend
echo "Starting Frontend service..."
(cd frontend && npm run dev) &
FRONTEND_PID=$!


echo "All services are starting in the background."
echo "Backend PID: $BACKEND_PID"
echo "AI Module PID: $AI_MODULE_PID"
echo "Frontend PID: $FRONTEND_PID"
echo "Press Ctrl+C to stop all services."

# Wait for all background jobs to finish
wait
</file>

<file path="stop-all.sh">
#!/bin/bash

echo "Stopping all services..."

# Find and kill processes by port
lsof -ti:5000 | xargs kill -9
lsof -ti:8000 | xargs kill -9
lsof -ti:3000 | xargs kill -9
lsof -ti:3001 | xargs kill -9 # Next.js might be on other ports
lsof -ti:3002 | xargs kill -9 # Next.js might be on other ports

# Also kill the docker-compose processes just in case
(cd backend/docker-environments && docker-compose down)

echo "All services stopped."
</file>

