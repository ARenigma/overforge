public class Product {
    private Long id;
    private String name;
    private String description;
    private Double price;
    private String category;
    private Integer stock;
    private Boolean available;

    // Constructors, getters, setters...
}</pre>
                        </div>
                        <button class="api-button" onclick="reloadModel()">
                            <i class="fas fa-sync-alt"></i> Check for Model
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function reloadModel() {
            const button = document.querySelector('.reload-btn');
            const originalText = button.innerHTML;
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Reloading...';
            button.disabled = true;

            fetch('/api/model/reload', { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    console.log('Reload response:', data);

                    // Show success/error message
                    const alertClass = data.success ? 'alert-success' : 'alert-warning';
                    const alertHtml = `
                        <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                            <i class="fas fa-${data.success ? 'check-circle' : 'exclamation-triangle'}"></i>
                            ${data.message}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    `;

                    document.querySelector('.container-fluid').insertAdjacentHTML('afterbegin', alertHtml);

                    // Reload page after a short delay to show updated model
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                })
                .catch(error => {
                    console.error('Error reloading model:', error);

                    const alertHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                                     '<i class="fas fa-exclamation-triangle"></i>' +
                                     'Error reloading model. Please try again.' +
                                     '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                                     '</div>';

                    document.querySelector('.container-fluid').insertAdjacentHTML('afterbegin', alertHtml);
                })
                .finally(() => {
                    button.innerHTML = originalText;
                    button.disabled = false;
                });
        }
    </script>
