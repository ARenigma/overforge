    if (!question) return "";
    const commentPrefix =
      selectedLanguage === "python"
        ? "# "
        : selectedLanguage === "javascript"
          ? "// "
          : selectedLanguage === "java"
            ? "// "
            : selectedLanguage === "cpp" || selectedLanguage === "csharp"
              ? "// "
              : selectedLanguage === "go"
                ? "// "
                : selectedLanguage === "rust"
                  ? "// "
                  : "# ";
    let problemText = question.description
      .replace(/<[^>]*>/g, "")
      .replace(/&nbsp;/g, " ")
      .replace(/&amp;/g, "&")
      .replace(/&lt;/g, "<")
      .replace(/&gt;/g, ">")
