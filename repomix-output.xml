"use client"

import { useState, useEffect } from "react"
import { useParams } from "next/navigation"
import { Button } from "@/components/ui/button"
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs"
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select"
import CodeEditor from "@/components/code-editor"
import ChatPanel from "@/components/chat-panel"
import VideoPanel from "@/components/video-panel"
import AIQuestionModal from "@/components/ai-question-modal"
import { useAuth } from "@/context/auth-context"
import { io, type Socket } from "socket.io-client"
import { Brain, Users, MessageCircle, Video, Timer } from "lucide-react"

export default function RoomInterface() {
  const params = useParams()
  const roomId = params?.id as string
  const [code, setCode] = useState("")
  const [language, setLanguage] = useState("javascript")
  const [experienceLevel, setExperienceLevel] = useState("junior")
  const [socket, setSocket] = useState<Socket | null>(null)
  const [isAIModalOpen, setIsAIModalOpen] = useState(false)
  const [timer, setTimer] = useState(0)
  const [isTimerRunning, setIsTimerRunning] = useState(true)
  const [participants, setParticipants] = useState<string[]>([])
  const { user, token } = useAuth()

  // Timer effect
  useEffect(() => {
    let interval: NodeJS.Timeout
    if (isTimerRunning) {
      interval = setInterval(() => {
        setTimer((prev) => prev + 1)
      }, 1000)
    }
    return () => clearInterval(interval)
  }, [isTimerRunning])

  // Socket connection
  useEffect(() => {
    if (!user || !token || !roomId) return

    const socketUrl = process.env.NEXT_PUBLIC_SOCKET_URL || "http://localhost:5000"
    const newSocket = io(socketUrl, {
      auth: { token },
      transports: ["websocket"],
    })

    newSocket.on("connect", () => {
      console.log("Socket connected")
      newSocket.emit("joinRoom", {
        roomName: roomId,
        userId: user.id,
        username: user.username,
      })
    })

    newSocket.on("codeUpdate", ({ code: newCode }) => {
      setCode(newCode)
    })

    newSocket.on("languageChange", ({ language: newLanguage }) => {
      setLanguage(newLanguage)
    })

    newSocket.on("roomParticipants", ({ participants: roomParticipants }) => {
      setParticipants(roomParticipants)
    })

    newSocket.on("connect_error", (err) => {
      console.error("Socket connection error:", err.message)
    })

    setSocket(newSocket)

    return () => {
      if (newSocket) {
        newSocket.emit("leaveRoom", {
          roomName: roomId,
          userId: user.id,
          username: user.username,
        })
        newSocket.disconnect()
      }
    }
  }, [roomId, user, token])

  const handleCodeChange = (newCode: string) => {
    setCode(newCode)

    if (socket) {
      socket.emit("codeChange", {
        roomName: roomId,
        code: newCode,
        language,
        userId: user?.id,
      })
    }
  }

  const handleLanguageChange = (newLanguage: string) => {
    setLanguage(newLanguage)

    if (socket) {
      socket.emit("languageChange", {
        roomName: roomId,
        language: newLanguage,
        userId: user?.id,
      })
    }
  }

  const formatTime = (seconds: number) => {
    const hours = Math.floor(seconds / 3600)
    const minutes = Math.floor((seconds % 3600) / 60)
    const secs = seconds % 60
    return `${hours.toString().padStart(2, "0")}:${minutes.toString().padStart(2, "0")}:${secs.toString().padStart(2, "0")}`
  }

  const handleTimerPause = () => {
    setIsTimerRunning(false)
  }

  const handleTimerResume = () => {
    setIsTimerRunning(true)
  }

  return (
    <div className="flex flex-col h-screen bg-background">
      {/* Header */}
      <header className="border-b bg-card">
        <div className="flex items-center justify-between p-4">
          <div className="flex items-center gap-4">
            <h1 className="text-xl font-bold">Room: {roomId}</h1>
            <div className="flex items-center gap-2 text-sm text-muted-foreground">
              <Users className="h-4 w-4" />
              <span>
                {participants.length} participant{participants.length !== 1 ? "s" : ""}
              </span>
            </div>
          </div>

          <div className="flex items-center gap-4">
            <div className="flex items-center gap-2">
              <Timer className="h-4 w-4" />
              <span className="font-mono text-lg">{formatTime(timer)}</span>
            </div>

            <Select value={experienceLevel} onValueChange={setExperienceLevel}>
              <SelectTrigger className="w-32">
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="junior">Junior</SelectItem>
                <SelectItem value="mid">Mid-level</SelectItem>
                <SelectItem value="senior">Senior</SelectItem>
              </SelectContent>
            </Select>

            <Button onClick={() => setIsAIModalOpen(true)} variant="outline">
              <Brain className="h-4 w-4 mr-2" />
              AI Question
            </Button>
          </div>
        </div>
      </header>

      {/* Main Content */}
      <div className="flex-1 flex overflow-hidden">
        {/* Left Panel - Code Editor */}
        <div className="flex-1 p-4">
          <CodeEditor
            value={code}
            onChange={handleCodeChange}
            language={language}
            onLanguageChange={handleLanguageChange}
          />
        </div>

        {/* Right Panel - Tabs */}
        <div className="w-96 border-l">
          <Tabs defaultValue="chat" className="h-full flex flex-col">
            <TabsList className="grid w-full grid-cols-2 m-4 mb-0">
              <TabsTrigger value="chat" className="flex items-center gap-2">
                <MessageCircle className="h-4 w-4" />
                Chat
              </TabsTrigger>
              <TabsTrigger value="video" className="flex items-center gap-2">
                <Video className="h-4 w-4" />
                Video
              </TabsTrigger>
            </TabsList>

            <TabsContent value="chat" className="flex-1 m-4 mt-2">
              <ChatPanel roomId={roomId} socket={socket} />
            </TabsContent>

            <TabsContent value="video" className="flex-1 m-4 mt-2">
              <VideoPanel roomId={roomId} userId={user?.id} socket={socket} />
            </TabsContent>
          </Tabs>
        </div>
      </div>

      {/* AI Question Modal */}
      <AIQuestionModal
        isOpen={isAIModalOpen}
        onClose={() => setIsAIModalOpen(false)}
        language={language}
        experienceLevel={experienceLevel}
        onTimerPause={handleTimerPause}
        onTimerResume={handleTimerResume}
      />
    </div>
  )
}
</file>

<file path="frontend/components/room-manager.tsx">
"use client"

import type React from "react"

import { useState, useEffect } from "react"
import { useRouter } from "next/navigation"
import { Button } from "@/components/ui/button"
import { Input } from "@/components/ui/input"
import { Label } from "@/components/ui/label"
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card"
import { Alert, AlertDescription } from "@/components/ui/alert"
import { Badge } from "@/components/ui/badge"
import { useAuth } from "@/context/auth-context"
import { Plus, Users, ArrowRight, Loader2 } from "lucide-react"

interface Room {
  id: string
  name: string
  participants: number
  createdAt: string
}

export default function RoomManager() {
  const [rooms, setRooms] = useState<Room[]>([])
  const [roomName, setRoomName] = useState("")
  const [joinName, setJoinName] = useState("")
  const [error, setError] = useState("")
  const [success, setSuccess] = useState("")
  const [loading, setLoading] = useState(false)
  const [creating, setCreating] = useState(false)
  const [joining, setJoining] = useState(false)
  const router = useRouter()
  const { token } = useAuth()

  useEffect(() => {
    fetchRooms()
  }, [])

  const fetchRooms = async () => {
    try {
      const response = await fetch("/api/rooms", {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      })

      if (response.ok) {
        const data = await response.json()
        setRooms(data.rooms || [])
      }
    } catch (err) {
      console.error("Failed to fetch rooms:", err)
    }
  }

  const handleCreateRoom = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!roomName.trim()) return

    setCreating(true)
    setError("")
    setSuccess("")

    try {
      const response = await fetch("/api/rooms", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({ name: roomName.trim() }),
      })

      if (!response.ok) {
        const data = await response.json()
        throw new Error(data.message || "Failed to create room")
      }

      setSuccess(`Room '${roomName}' created successfully!`)
      setRoomName("")

      // Navigate to the room after a short delay
      setTimeout(() => {
        router.push(`/room/${encodeURIComponent(roomName.trim())}`)
      }, 1000)

      fetchRooms()
    } catch (err) {
      setError(err instanceof Error ? err.message : "Failed to create room")
    } finally {
      setCreating(false)
    }
  }

  const handleJoinRoom = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!joinName.trim()) return

    setJoining(true)
    setError("")
    setSuccess("")

    try {
      const response = await fetch("/api/rooms/join", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({ name: joinName.trim() }),
      })

      if (!response.ok) {
        const data = await response.json()
        throw new Error(data.message || "Failed to join room")
      }

      setSuccess(`Joined room '${joinName}'!`)

      // Navigate to the room
      setTimeout(() => {
        router.push(`/room/${encodeURIComponent(joinName.trim())}`)
      }, 1000)

      setJoinName("")
    } catch (err) {
      setError(err instanceof Error ? err.message : "Failed to join room")
    } finally {
      setJoining(false)
    }
  }

  const joinExistingRoom = (roomName: string) => {
    router.push(`/room/${encodeURIComponent(roomName)}`)
  }

  return (
    <div className="min-h-screen bg-background p-4">
      <div className="max-w-4xl mx-auto space-y-6">
        <div className="text-center">
          <h1 className="text-3xl font-bold">Room Manager</h1>
          <p className="text-muted-foreground mt-2">
            Create a new room or join an existing one to start your coding interview
          </p>
        </div>

        {error && (
          <Alert variant="destructive">
            <AlertDescription>{error}</AlertDescription>
          </Alert>
        )}

        {success && (
          <Alert>
            <AlertDescription>{success}</AlertDescription>
          </Alert>
        )}

        <div className="grid md:grid-cols-2 gap-6">
          {/* Create Room */}
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <Plus className="h-5 w-5" />
                Create New Room
              </CardTitle>
              <CardDescription>Start a new coding interview session</CardDescription>
            </CardHeader>
            <CardContent>
              <form onSubmit={handleCreateRoom} className="space-y-4">
                <div className="space-y-2">
                  <Label htmlFor="roomName">Room Name</Label>
                  <Input
                    id="roomName"
                    type="text"
                    placeholder="Enter room name"
                    value={roomName}
                    onChange={(e) => setRoomName(e.target.value)}
                    disabled={creating}
                  />
                </div>
                <Button type="submit" className="w-full" disabled={creating}>
                  {creating && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}
                  Create Room
                </Button>
              </form>
            </CardContent>
          </Card>

          {/* Join Room */}
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <ArrowRight className="h-5 w-5" />
                Join Existing Room
              </CardTitle>
              <CardDescription>Enter a room name to join an ongoing session</CardDescription>
            </CardHeader>
            <CardContent>
              <form onSubmit={handleJoinRoom} className="space-y-4">
                <div className="space-y-2">
                  <Label htmlFor="joinName">Room Name</Label>
                  <Input
                    id="joinName"
                    type="text"
                    placeholder="Enter room name to join"
                    value={joinName}
                    onChange={(e) => setJoinName(e.target.value)}
                    disabled={joining}
                  />
                </div>
                <Button type="submit" className="w-full" disabled={joining}>
                  {joining && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}
                  Join Room
                </Button>
              </form>
            </CardContent>
          </Card>
        </div>

        {/* Active Rooms */}
        <Card>
          <CardHeader>
            <CardTitle className="flex items-center gap-2">
              <Users className="h-5 w-5" />
              Active Rooms
            </CardTitle>
            <CardDescription>Click on any room to join</CardDescription>
          </CardHeader>
          <CardContent>
            {rooms.length > 0 ? (
              <div className="grid gap-3">
                {rooms.map((room) => (
                  <div
                    key={room.id}
                    className="flex items-center justify-between p-3 border rounded-lg hover:bg-muted/50 cursor-pointer transition-colors"
                    onClick={() => joinExistingRoom(room.name)}
                  >
                    <div className="flex items-center gap-3">
                      <div>
                        <h3 className="font-medium">{room.name}</h3>
                        <p className="text-sm text-muted-foreground">
                          Created {new Date(room.createdAt).toLocaleDateString()}
                        </p>
                      </div>
                    </div>
                    <div className="flex items-center gap-2">
                      <Badge variant="outline">
                        {room.participants} participant{room.participants !== 1 ? "s" : ""}
                      </Badge>
                      <ArrowRight className="h-4 w-4 text-muted-foreground" />
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div className="text-center py-8 text-muted-foreground">
                <Users className="h-12 w-12 mx-auto mb-4 opacity-50" />
                <p>No active rooms found</p>
                <p className="text-sm">Create a new room to get started</p>
              </div>
            )}
          </CardContent>
        </Card>
      </div>
    </div>
  )
}
</file>

