    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1.5'
          memory: 768M
        reservations:
          cpus: '0.5'
          memory: 256M
    security_opt:
      - no-new-privileges:true
    read_only: false
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=100m
    command: tail -f /dev/null

  # Core language containers
  java-core:
    build:
      context: .
      dockerfile: ./java-core/Dockerfile
    command: tail -f /dev/null
    container_name: interview-java-core
    volumes:
      - ./workspace/java-core:/app
    networks:
      - interview-network

  python-core:
    build:
      context: .
      dockerfile: ./python-core/Dockerfile
    command: tail -f /dev/null
    container_name: interview-python-core
    volumes:
      - ./workspace/python-core:/app
    networks:
      - interview-network

