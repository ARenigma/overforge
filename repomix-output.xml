                                     '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                                     '</div>';

                    document.querySelector('.container-fluid').insertAdjacentHTML('afterbegin', alertHtml);
                })
                .finally(() => {
                    button.innerHTML = originalText;
                    button.disabled = false;
                });
        }
