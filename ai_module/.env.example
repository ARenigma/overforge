# ─────── AI module / FastAPI — copy to .env and fill in ───────

# Server
AI_MODULE_HOST=0.0.0.0
AI_MODULE_PORT=9001
DEBUG_MODE=false

# AI provider — one of: codestral | mistral | openrouter | ollama
PRIMARY_AI_PROVIDER=codestral

# Mistral / Codestral (direct)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
CODESTRAL_API_KEY=
CODESTRAL_MODEL=codestral-latest

# OpenRouter (aggregator — recommended)
OPENROUTER_API_KEY=
OPENROUTER_VALIDATION_MODELS=mistralai/codestral-2501:1,qwen/qwen-2.5-coder-32b-instruct:2
OPENROUTER_QUESTION_GENERATION_MODELS=mistralai/codestral-2501:1,qwen/qwen-2.5-coder-32b-instruct:2
OPENROUTER_COUNTER_QUESTION_MODELS=mistralai/codestral-2501:1,qwen/qwen-2.5-coder-32b-instruct:2

# Ollama (local fallback)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=codellama:7b
ENABLE_OLLAMA_FALLBACK=true
