# Voice-service host secrets/config — copy to deploy/voice.env ON THE VPS ONLY (never commit;
# CI rsyncs deploy/ with --exclude voice.env so the host copy survives deploys).
# The file is optional: without it the voice service boots on the default local whisper path.

# ── STT provider (P1-A) ──────────────────────────────────────────────────────────────────
# 'whisper' (default when unset) = local Silero + Smart-Turn + faster-whisper.
# 'assemblyai' = AssemblyAI v3 real-time streaming STT + built-in semantic turn detection
# (no false-cuts on thinking pauses; transcript rides the end-of-turn event → stt_ms ≈ 0).
STT_PROVIDER=assemblyai

# Raw AssemblyAI API key (sent as the Authorization header, no Bearer prefix). REQUIRED for
# STT_PROVIDER=assemblyai; if missing the service logs an error and stays on whisper.
ASSEMBLYAI_API_KEY=

# Comma-separated domain terms boosted in recognition (→ keyterms_prompt; max 100 terms,
# each ≤ 50 chars). Optional. Shared with the Soniox shadow (context.terms) for a fair A/B.
# STT_KEYTERMS=Overforge,big-O,hash map,linked list

# ── Shadow STT (A/B comparison) ──────────────────────────────────────────────────────────
# Runs a SECOND engine in parallel on the same audio, log-only, to benchmark it against the
# primary on real interviews. Pure observer: it never drives turns and can never affect the
# live interview (isolated + best-effort). Per-turn it captures both transcripts + rough
# latency into voice_turn_telemetry (primary_transcript / shadow_* columns) for offline
# disagreement analysis. 'soniox' = Soniox stt-rt-v5; unset/'none' = no shadow.
STT_SHADOW=soniox

# Raw Soniox API key. REQUIRED for STT_SHADOW=soniox; if missing the shadow is disabled and
# the primary is untouched.
SONIOX_API_KEY=

# Soniox model override (→ shadow model). Optional; default stt-rt-v5.
# SONIOX_MODEL=stt-rt-v5

# ── Turn-detection tuning (optional; generous interview defaults shown) ──────────────────
# Model tier (→ speech_model). universal-3-5-pro is the v3 default tier; plain
# 'universal-3-pro' is rejected. Confidence-based alternatives: universal-streaming-english,
# universal-streaming-multilingual.
# STT_SPEECH_MODEL=universal-3-5-pro
# Minimum trailing silence (ms) before a confident end-of-turn may fire (→ min_turn_silence).
# STT_MIN_TURN_SILENCE_MS=800
# Acoustic backstop (ms): silence alone force-commits the turn (→ max_turn_silence). 6000 gives
# candidates room for deep-recall thinking pauses (3s was clipping them). Tune from prod telemetry.
STT_MAX_TURN_SILENCE_MS=6000
# Transcription prompt (u3-pro): steers punctuation, which IS turn detection on u3-pro. Defaults
# (in code) to a filler-continuation prompt so a lone "um"/"uh" + pause does NOT end the turn.
# MUTUALLY EXCLUSIVE with STT_KEYTERMS. Set STT_PROMPT= (empty) to disable + use AAI's built-in.
# STT_PROMPT=
# Semantic EOT confidence bar, 0-1 (→ end_of_turn_confidence_threshold; used by the
# universal-streaming-* tiers).
# STT_EOT_CONFIDENCE=0.4
