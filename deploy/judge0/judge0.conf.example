# Judge0 configuration (copy to judge0.conf and fill secrets). Minimal set; see
# the upstream judge0.conf for the full list of tunables.

# ── Postgres ──
POSTGRES_HOST=judge0-db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=CHANGE_ME_pg

# ── Redis ──
REDIS_HOST=judge0-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis

# ── Auth (becomes the backend's JUDGE0_AUTH_TOKEN via X-Auth-Token) ──
AUTHN_TOKEN=CHANGE_ME_authn
AUTHZ_TOKEN=CHANGE_ME_authz

# ── Limits (tune for interview workloads) ──
MAX_CPU_TIME_LIMIT=10
MAX_MEMORY_LIMIT=256000
ENABLE_WAIT_RESULT=true
ALLOW_ENABLE_NETWORK=false
