# ─────── Backend: Core API & Orchestration — copy to .env and fill the blanks ───────
# Real secrets go in .env (gitignored). This file documents the shape only.

# Runtime
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ──
SUPABASE_URL=https://aplpiamqwcdvgtxecskr.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, for running migrations (Project Settings → Database → Connection string)
SUPABASE_DB_URL=

# ── Minimax (the single, pinned LLM; voice IDs added in M2) ──
MINIMAX_API_KEY=
MINIMAX_LLM_MODEL=
# Optional, only if your Minimax account requires them:
MINIMAX_GROUP_ID=
# MINIMAX_BASE_URL=https://api.minimax.io/v1/text/chatcompletion_v2

# ── Judge0 execution kernel (Service 2, self-hosted on the VPS) ──
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=

# ── Resend (interviewer scorecard email) ──
RESEND_API_KEY=
RESEND_FROM=
