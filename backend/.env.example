# ─────── Backend: Core API & Orchestration — copy to .env and fill the blanks ───────
# Real secrets go in .env (gitignored). This file documents the shape only.
# Never put real values here.

# ── Runtime ──
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ──
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM chain — MiniMax primary ──
MINIMAX_API_KEY=
MINIMAX_LLM_MODEL=MiniMax-Text-01
MINIMAX_FAST_MODEL=MiniMax-Text-01
MINIMAX_BASE_URL=https://api.minimax.io/v1
# Only required if your MiniMax account uses group-based billing:
MINIMAX_GROUP_ID=

# ── LLM chain — Groq fallback ──
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REASONING_EFFORT=
# JSON array of {provider,model} objects, evaluated left-to-right on primary failure:
GROQ_FALLBACK_CHAIN_JSON=[]

# ── LLM chain — Cerebras fallback ──
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_REASONING_EFFORT=

# ── LLM general ──
LLM_TIMEOUT_MS=30000
# JSON map of {provider: {input_usd_per_mtok, output_usd_per_mtok}} for cost accounting:
LLM_PRICING_JSON={}

# ── TTS provider switch ──
# 'cartesia' (default) or 'grok'. Switch here; no route code changes needed.
TTS_PROVIDER=cartesia

# ── Cartesia / voice TTS ──
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2
CARTESIA_VERSION=2024-06-10
CARTESIA_SPEED=normal
# Comma-separated phoneme break overrides sent in SSML (leave blank for defaults):
CARTESIA_BREAKS=

# ── xAI Grok TTS (used when TTS_PROVIDER=grok) ──
XAI_API_KEY=
# Voice name to use (default: sirius — the only voice validated against api.x.ai):
GROK_TTS_VOICE=sirius
# BCP-47 language code (default: en):
GROK_TTS_LANGUAGE=en
# Speaking speed in [0.7, 1.5] — 1.0 = normal, 0.92 = slight natural slow-down (default):
GROK_TTS_SPEED=0.92
# Cost accounting: USD per 1M characters (default: 15 — verify against xAI billing page):
GROK_TTS_USD_PER_MCHAR=15

# ── Resend (interviewer scorecard email) ──
RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com

# ── Sentry ──
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Sandbox / code execution (Docker-per-run, gVisor) ──
# Set to "runsc" for gVisor in prod; leave blank or "runc" for plain Docker locally:
SANDBOX_RUNTIME=runc
EXEC_MAX_CONCURRENCY=4
EXEC_USD_PER_HOUR=0.0
# Named Docker volume to cache the Go module cache across runs (leave blank to disable):
GO_CACHE_VOLUME=

# ── Voice cost accounting ──
STT_USD_PER_HOUR=0.45
TTS_USD_PER_MCHAR=0.0

# ── Retention / backup ──
RETENTION_ENABLED=false
RETENTION_DAYS=90

# ── Interviewer persona ──
# Short name spoken in the greeting and used when the candidate addresses the interviewer.
# Override to rebrand without a deploy (takes effect on restart). Default: Finn
INTERVIEWER_NAME=Finn

# ── Rate / dev ──
# Minutes for a normal interview session:
INTERVIEW_DURATION_MIN=60
# Comma-separated emails that get shortened dev interviews:
DEV_EMAILS=
# Minutes for a dev interview (only applies to DEV_EMAILS addresses):
DEV_INTERVIEW_DURATION_MIN=2
# Hours before a candidate access token expires:
TOKEN_TTL_HOURS=72
# Enable idle-nudge probes in the coding phase (set to "1" to enable):
IDLE_NUDGE_ENABLED=1
# Engagement shadow mode: computes + logs engagement state transitions, no behavior change.
# Default ON when unset. Set to "0" to disable entirely.
ENGAGEMENT_SHADOW=
# Engagement interventions P2: Path C (quiescent probes/offers), encourage kind, observer notes,
# async run-wording off the /run response. Default OFF — enable after prod telemetry validates P1.
# Set to "1" to enable.
ENGAGEMENT_INTERVENTIONS=
# Regex matched against the request Origin header to allow Vercel preview URLs for CORS:
CORS_PREVIEW_REGEX=
