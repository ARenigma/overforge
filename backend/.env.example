# ─────── Backend / Node — copy to .env and fill in ───────

# Runtime
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000
DISABLE_DOCKER=false

# Database (Supabase — fill from project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: legacy direct DB (used by some scripts)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=overforge

# AI module endpoint (called by LHIS)
AI_MODULE_URL=http://localhost:9001

# Debug flags (any of these = "true" enables verbose logging)
DEBUG_AI_REQUESTS=false
DEBUG_ASSESSMENT=false
DEBUG_SOCKETS=false
DEBUG_VALIDATION=false

# LHIS tunables (all optional — sensible defaults in code)
LHIS_FIRST_CHECKIN_DELAY=10000
LHIS_INACTIVITY_NO_CODE=30000
LHIS_INACTIVITY_WITH_CODE=120000
LHIS_MIN_ENGAGEMENT_INTERVAL=20000
LHIS_PROACTIVE_CHECK_INTERVAL=8000
LHIS_MAX_SESSION_DURATION=7200000
LHIS_WELCOME_DELAY=2000
MIN_CODE_LENGTH=10
ENABLE_CHAMPION_VALIDATION=false

# Judge0 (only if you bypass the bundled Docker containers)
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
