# ===========================================
# OVERFORGE BACKEND ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and configure your values
# Most settings have sensible defaults based on NODE_ENV

# ===========================================
# CORE ENVIRONMENT
# ===========================================
NODE_ENV=development
PORT=8000

# ===========================================
# CODE VALIDATION SYSTEM TOGGLES
# ===========================================
ENABLE_CODE_VALIDATION=true           # Master toggle - disables everything
ENABLE_CHAMPION_VALIDATION=true       # AI relevance checking (expensive)
ENABLE_COUNTER_QUESTIONS=true        # AI-generated follow-up questions

# ===========================================
# COUNTER QUESTION TIMING
# ===========================================
# ⚠️  TIMING IS AUTOMATICALLY SET BY NODE_ENV:
#     development: 30s, 60s, 90s (fast feedback)
#     test: 15s, 30s, 45s (quick testing)
#     production: 2min, 4min, 6min (realistic timing)
#
# 🔧 MANUAL OVERRIDES (only use if you need custom timing):
# COUNTER_Q1_INTERVAL=60000     # First counter question (1 minute default)
# COUNTER_Q2_INTERVAL=120000    # Second counter question (2 minutes default)
# COUNTER_Q3_INTERVAL=180000    # Third counter question (3 minutes default)

# Base interval for calculations (optional)
COUNTER_Q_BASE_INTERVAL=60000 # Base interval (1 minute)

# ===========================================
# AI MODULE CONFIGURATION
# ===========================================
AI_MODULE_URL=http://localhost:8000
AI_REQUEST_TIMEOUT=30000
AI_MAX_RETRIES=3
AI_RETRY_DELAY=2000

# Note: AI model configuration (OpenRouter API keys, model selection) 
# is handled by the separate AI module at ai_module/.env
# Backend only needs to know where to reach the AI service

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_DIALECT=postgres

# Database Connection Pool
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Service Configuration
OPENROUTER_API_KEY=your_openrouter_api_key

# ===========================================
# SOCKET.IO CONFIGURATION
# ===========================================
SOCKET_PORT=5000
SOCKET_TIMEOUT=30000
SOCKET_MAX_RETRIES=5
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# ===========================================
# ROOM/SESSION CONFIGURATION
# ===========================================
ROOM_MAX_PARTICIPANTS=10
ROOM_CLEANUP_DELAY=300000     # 5 minutes
ROOM_MAX_LIFETIME=86400000    # 24 hours

# ===========================================
# CODE ANALYSIS CONFIGURATION
# ===========================================
CODE_ANALYSIS_DEBOUNCE=1500
CODE_UPDATE_THROTTLE=10000
MAX_CODE_LENGTH=10000

# ===========================================
# CHAT CONFIGURATION
# ===========================================
CHAT_MAX_MESSAGE_LENGTH=500
CHAT_RATE_LIMIT=30
CHAT_HISTORY_LENGTH=100

# ===========================================
# QUESTION GENERATION
# ===========================================
QUESTIONS_INITIAL_COUNT=2
QUESTIONS_MAX_COUNT=10
QUESTIONS_GENERATION_TIMEOUT=30000
QUESTIONS_ENABLE_FALLBACK=true

# ===========================================
# TESTING CONFIGURATION
# ===========================================
# Fast intervals for E2E testing (only used when NODE_ENV=test)
TEST_COUNTER_Q_INTERVAL=15000          # Counter question interval for testing (15 seconds)
TEST_MAX_COUNTER_Q=3
TEST_CONNECTION_TIMEOUT=15000
TEST_QUESTION_TIMEOUT=30000
TEST_TOTAL_TIMEOUT=300000              # 5 minutes

# Enable test mode manually (overrides NODE_ENV check)
# ENABLE_TEST_MODE=true

# ===========================================
# PERFORMANCE & LIMITS
# ===========================================
MEMORY_CLEANUP_INTERVAL=600000         # 10 minutes
MAX_CONCURRENT_ROOMS=1000
RATE_LIMIT_PER_IP=100

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
# Log level: error, warn, info, debug (auto-set by NODE_ENV if not specified)
LOG_LEVEL=info

# Debug flags (auto-enabled in development if not specified)
# DEBUG_MODE=true
# SOCKET_DEBUG=true
# AI_DEBUG=true

# Optional log file
# LOG_FILE_PATH=./logs/backend.log

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ===========================================
# EXTERNAL SERVICES
# ===========================================
# Judge0 Configuration (if using code execution)
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_judge0_api_key
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Redis Configuration (if using caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ===========================================
# DEVELOPMENT HELPERS
# ===========================================
# Enable detailed request logging in development
# REQUEST_LOGGING=true

# Enable SQL query logging
# SQL_LOGGING=true

# Hot reload for development
# HOT_RELOAD=true

# ===========================================
# ENVIRONMENT-SPECIFIC EXAMPLES
# ===========================================

# 🚀 DEVELOPMENT SETUP (NODE_ENV=development)
# - Counter questions: 30s, 60s, 90s
# - Debug logging enabled
# - Fast feedback for development
# - Code validation: ALL FEATURES ENABLED
#   ENABLE_CODE_VALIDATION=true
#   ENABLE_CHAMPION_VALIDATION=true
#   ENABLE_COUNTER_QUESTIONS=true

# 🧪 TEST SETUP (NODE_ENV=test)  
# - Counter questions: 15s, 30s, 45s
# - Minimal logging
# - Quick test cycles
# - Code validation: SECURITY ONLY (fast testing)
#   ENABLE_CODE_VALIDATION=true
#   ENABLE_CHAMPION_VALIDATION=false
#   ENABLE_COUNTER_QUESTIONS=false

# 🏭 PRODUCTION SETUP (NODE_ENV=production)
# - Counter questions: 2min, 4min, 6min
# - Info-level logging only
# - Realistic interview timing 
# - Code validation: ALL FEATURES ENABLED
#   ENABLE_CODE_VALIDATION=true
#   ENABLE_CHAMPION_VALIDATION=true
#   ENABLE_COUNTER_QUESTIONS=true

# ===========================================
# VALIDATION MODES QUICK REFERENCE
# ===========================================
# 
# 🚀 FULL VALIDATION MODE (Development/Production)
#    ENABLE_CODE_VALIDATION=true
#    ENABLE_CHAMPION_VALIDATION=true
#    ENABLE_COUNTER_QUESTIONS=true
#    - Security checks via basic patterns
#    - AI relevance checking (Champion AI)
#    - AI-generated follow-up questions
#    - Best user experience, highest resource usage
#
# ⚡ SECURITY-ONLY MODE (Testing/Budget-Conscious)
#    ENABLE_CODE_VALIDATION=true
#    ENABLE_CHAMPION_VALIDATION=false
#    ENABLE_COUNTER_QUESTIONS=false
#    - Security checks via basic patterns only
#    - No AI analysis (fast & cheap)
#    - Good for testing or when AI budget is limited
#
# 🔇 DISABLED MODE (Performance Testing)
#    ENABLE_CODE_VALIDATION=false
#    - No validation at all
#    - Fastest performance for load testing 

# === LHIS TIMING CONFIGURATION ===
# All timings are in milliseconds

# Core Engagement Timings
LHIS_WELCOME_DELAY=2000                    # Welcome message delay after initialization
LHIS_FIRST_CHECKIN_DELAY=60000             # First proactive check-in (1 minute)

# Inactivity Thresholds
LHIS_INACTIVITY_WITH_CODE=90000            # Inactivity timeout when coding (1.5 minutes)
LHIS_INACTIVITY_NO_CODE=180000             # Inactivity timeout with no code (3 minutes)
LHIS_STUCK_CHECK_THRESHOLD=150000          # "Stuck" detection threshold (2.5 minutes)

# Engagement Intervals
LHIS_MIN_ENGAGEMENT_INTERVAL=180000        # Minimum time between engagements (3 minutes)
LHIS_PROACTIVE_CHECK_INTERVAL=60000        # How often to check for engagement opportunities (1 minute)

# Assessment Timing
LHIS_PARAMETER_QUESTION_DELAY=2000         # Delay before asking depth questions
LHIS_RETRY_GUIDANCE_DELAY=2000             # Delay before retry guidance
LHIS_NEXT_PARAMETER_DELAY=2000             # Delay before moving to next parameter

# Hint System Timing
LHIS_HINT_OFFER_DELAY=300000               # Time before offering hints (5 minutes)
LHIS_HINT_EFFECTIVENESS_CHECK=30000        # Check hint effectiveness after (30 seconds)
LHIS_FOLLOWUP_REMINDER_DELAY=120000        # Follow-up reminder delay (2 minutes)

# Response Generation
LHIS_AI_RESPONSE_TIMEOUT=10000             # Max time for AI response generation
LHIS_HUMAN_PAUSE_MIN=1000                  # Minimum human-like pause
LHIS_HUMAN_PAUSE_MAX=3000                  # Maximum human-like pause
LHIS_TYPING_SIMULATION_DELAY=100           # Typing speed simulation per character

# Debounce Timings
LHIS_ASSESSMENT_INIT_DEBOUNCE=2000         # Assessment initialization debounce
LHIS_CODE_CHANGE_DEBOUNCE=500              # Code change event debounce
LHIS_SOCKET_CONNECTION_DEBOUNCE=1000       # Socket connection debounce

# Session Management
LHIS_SESSION_CLEANUP_INTERVAL=300000       # Session cleanup interval (5 minutes)
LHIS_SESSION_TIMEOUT_WARNING=1800000       # Session timeout warning (30 minutes)
LHIS_MAX_SESSION_DURATION=3600000          # Maximum session duration (60 minutes)
LHIS_SESSION_HEARTBEAT_INTERVAL=30000      # Session heartbeat check (30 seconds)

# Milestone-based Engagement
LHIS_NO_CODE_1MIN_CHECK=60000              # Check for no code after 1 minute
LHIS_NO_CODE_3MIN_CHECK=180000             # Urgent check after 3 minutes
LHIS_PROGRESS_CHECK_2MIN=120000            # Progress check after 2 minutes coding
LHIS_ENCOURAGEMENT_INTERVAL=300000         # Periodic encouragement (5 minutes)

# === VALIDATION CONFIGURATION ===
ENABLE_CHAMPION_VALIDATION=true
MIN_CODE_LENGTH=10

# === LOGGING CONFIGURATION ===
ENABLE_DEBUG_LOGGING=false

# === CONTENT MODERATION ===
ENABLE_AI_CONTENT_MODERATION=true
CONTENT_MODERATION_THRESHOLD=0.7 