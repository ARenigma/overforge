{
  "name": "overforge-backend",
  "version": "1.0.0",
  "description": "Backend for Overforge - 3-Parameter Assessment System",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon",
    "start:no-docker": "DISABLE_DOCKER=true node src/app.js",
    "dev:no-docker": "DISABLE_DOCKER=true nodemon",
    "docker:start": "cd docker-environments && ./manage.sh start",
    "docker:stop": "cd docker-environments && ./manage.sh stop",
    "docker:status": "cd docker-environments && ./manage.sh status",
    "docker:logs": "cd docker-environments && ./manage.sh logs",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.js\" \"__tests__/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" \"__tests__/**/*.js\" --fix",
    "seed:solutions:dry": "node scripts/seed-problem-solutions.js --dry-run --limit 10",
    "seed:solutions": "node scripts/seed-problem-solutions.js --limit 50",
    "migrate": "sequelize-cli db:migrate",
    "seed": "sequelize-cli db:seed:all",
    "reset-db": "sequelize-cli db:drop && sequelize-cli db:create && sequelize-cli db:migrate && sequelize-cli db:seed:all"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "axios": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "form-data": "^4.0.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.1",
    "mime-types": "^3.0.1",
    "multer": "^2.0.1",
    "node-fetch": "^2.7.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.0",
    "sequelize": "^6.37.7",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.1",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "sequelize-cli": "^6.6.3",
    "supertest": "^7.0.0"
  },
  "keywords": [
    "interview",
    "assessment",
    "ai",
    "coding"
  ],
  "author": "Overforge Team",
  "license": "MIT"
}
