# ─────── Frontend: Next.js — copy to .env.local and fill the blanks ───────
# Browser-exposed values must be safe to ship publicly (anon key only — NEVER the
# service-role key here; orchestration/secrets live on the backend).

# ── Core API (browser + SSR) ──
NEXT_PUBLIC_API_URL=http://localhost:5001

# ── Supabase (browser-safe) ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Voice service (optional — leave blank for text-only sessions) ──
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:5002

# ── TTS streaming mode ("1" enables browser-side TTS stream, blank = backend audio) ──
NEXT_PUBLIC_TTS_STREAM=

# ── Sentry (optional — leave blank to disable client-side error reporting) ──
NEXT_PUBLIC_SENTRY_DSN=

# ── Site identity (used in OG tags / canonical URLs) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cal.com booking link (used in landing CTA, optional) ──
NEXT_PUBLIC_CAL_LINK=

# ── Vercel-injected — DO NOT set these locally; Vercel sets them automatically ──
# NEXT_PUBLIC_VERCEL_ENV=
# NEXT_PUBLIC_VERCEL_URL=
